{
    "name": "@script-development/ui-form",
    "version": "0.0.0",
    "private": true,
    "description": "Vue 3 form components and form state in one package, succeeding ui-inputs and fs-form. Not published yet.",
    "homepage": "https://packages.script.nl/packages/ui-form",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/script-development/fs-packages.git",
        "directory": "packages/ui-form"
    },
    "files": [
        "dist",
        "styles.css"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./style.css": "./styles.css"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "scripts": {
        "build": "tsdown",
        "lint:pkg": "publint && attw --pack",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:mutation": "stryker run",
        "typecheck": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@floating-ui/vue": "^2.0.1"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "@vue/test-utils": "^2.5.1",
        "happy-dom": "^21.0.3",
        "unplugin-vue": "^8.0.0",
        "vue": "^3.5.44",
        "vue-tsc": "^3.3.13"
    },
    "peerDependencies": {
        "vue": "^3.5.44"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
